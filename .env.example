# En el servidor, docker-compose.yml toma de acá DB_PASSWORD, JWT_SECRET,
# ADMIN_PASSWORD y VB_WEBHOOK_SECRET. Generar con: openssl rand -hex 32
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gestion_ejecutivos
DB_SYNC=true
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123
PORT=3000

# Secreto compartido con vb-api (backend de la landing) para firmar el webhook
# POST /api/webhooks/vb. Mínimo 32 caracteres. Generar con: openssl rand -hex 32
VB_WEBHOOK_SECRET=
