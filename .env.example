# Copiar a .env y completar. Los secretos van vacíos a propósito: en el
# servidor, docker-compose.yml no arranca si falta alguno.
# Generar cada uno con: openssl rand -hex 32

# --- Secretos (los usa docker-compose.yml en el servidor) ---
# Tiene que coincidir con la contraseña real del usuario postgres.
DB_PASSWORD=
JWT_SECRET=
# Solo se usa al crear el admin por primera vez (seed).
ADMIN_PASSWORD=
# Compartido con vb-api (landing) para firmar POST /api/webhooks/vb.
# Mínimo 32 caracteres; vacío = el webhook responde 503.
VB_WEBHOOK_SECRET=

# --- Solo desarrollo local (en Docker los fija docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=gestion_ejecutivos
DB_SYNC=true
ADMIN_EMAIL=admin@empresa.com
PORT=3000
